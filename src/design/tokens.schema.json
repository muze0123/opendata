{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metritag CSS tokens v1",
  "type": "object",
  "required": ["format", "source", "blocks"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "metritag-css-tokens-v1" },
    "source": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "migrationNote": { "type": "string" },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["selector", "values"],
        "additionalProperties": false,
        "properties": {
          "selector": { "type": "string", "minLength": 1 },
          "values": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "pattern": "^--[A-Za-z0-9_-]+$" },
            "additionalProperties": { "type": "string", "minLength": 1, "pattern": "^[^;{}]+$" }
          }
        }
      }
    }
  }
}
