{
  "$schema": "./tokens.schema.json",
  "format": "metritag-css-tokens-v1",
  "source": "DESIGN.md",
  "version": "1.0.0",
  "blocks": [
    {
      "selector": "body",
      "values": {
        "--mt-ds-space-1": "4px",
        "--mt-ds-space-2": "8px",
        "--mt-ds-space-3": "12px",
        "--mt-ds-space-4": "16px",
        "--mt-ds-space-5": "20px",
        "--mt-ds-space-6": "24px",
        "--mt-ds-control-height": "32px",
        "--mt-ds-control-radius": "2px",
        "--mt-ds-font-body": "14px",
        "--mt-ds-line-body": "22px",
        "--mt-ds-font-title": "16px",
        "--mt-ds-line-title": "24px",
        "--mt-ds-font-caption": "12px",
        "--mt-ds-line-caption": "20px",
        "--mt-ds-weight-body": "400",
        "--mt-ds-weight-title": "600",
        "--mt-ds-form-width": "500px",
        "--mt-ds-filter-width": "200px",
        "--mt-ds-confirm-width": "560px",
        "--mt-ds-confirm-height": "250px",
        "--mt-ds-header-height": "56px",
        "--mt-ds-sidebar-width": "205px",
        "--mt-ds-sidebar-collapsed": "64px",
        "--mt-ds-primary": "var(--app-color-primary)",
        "--mt-ds-surface": "var(--app-surface-container)",
        "--mt-ds-text": "var(--app-text-primary)",
        "--mt-ds-text-secondary": "var(--app-text-secondary)",
        "--mt-ds-text-muted": "var(--app-text-muted)",
        "--mt-ds-border": "var(--app-control-border)",
        "--mt-ds-detail-label-width": "112px",
        "--mt-ds-detail-row-gap": "10px",
        "--mt-ds-confirm-icon": "20px",
        "--mt-ds-dialog-header-height": "48px"
      }
    },
    {
      "selector": "html",
      "values": {
        "--mt-ds-field-colon": "'：'"
      }
    },
    {
      "selector": "html[lang='en-US']",
      "values": {
        "--mt-ds-field-colon": "':'"
      }
    }
  ]
}
