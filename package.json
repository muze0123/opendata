{
  "name": "opendata",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --dir frontend dev",
    "build": "pnpm --dir frontend build",
    "preview": "pnpm --dir frontend preview",
    "typecheck": "pnpm --dir frontend typecheck",
    "verify": "pnpm --dir frontend verify",
    "i18n:extract": "pnpm --dir frontend i18n:extract",
    "i18n:check": "pnpm --dir frontend i18n:check",
    "i18n:cjk": "pnpm --dir frontend i18n:cjk",
    "design:tokens": "pnpm --dir frontend design:tokens",
    "design:tokens:check": "pnpm --dir frontend design:tokens:check",
    "design:check": "pnpm --dir frontend design:check",
    "design:audit": "pnpm --dir frontend design:audit",
    "design:test": "pnpm --dir frontend design:test",
    "design:context": "pnpm --dir frontend design:context",
    "design:browser": "pnpm --dir frontend design:browser",
    "design:sync": "pnpm --dir frontend design:sync",
    "check": "pnpm --dir frontend check",
    "dev:workflow": "node scripts/dev-workflow.mjs",
    "workflow:server": "node backend/workflow/server.mjs",
    "test:workflow": "node --test backend/workflow/*.test.mjs",
    "workflow:warmflow": "mvn -f backend/warmflow/pom.xml spring-boot:run",
    "test:workflow:native": "mvn -f backend/warmflow/pom.xml test && node scripts/test-workflow-native.mjs",
    "install:frontend": "pnpm --dir frontend install --frozen-lockfile",
    "backend:verify": "mvn -B -f backend/pom.xml verify",
    "backend:package": "mvn -B -f backend/pom.xml -DskipTests package",
    "backend:run": "mvn -f backend/application/pom.xml spring-boot:run",
    "backend:local": "mvn -f backend/application/pom.xml -Dspring-boot.run.profiles=local spring-boot:run",
    "backend:dev": "mvn -f backend/application/pom.xml test-compile spring-boot:test-run -Dspring-boot.run.main-class=com.metritag.opendata.LocalDevelopmentApplication",
    "contracts:generate": "node scripts/generate-task-types.mjs",
    "contracts:check": "node scripts/generate-task-types.mjs --check",
    "dev:business": "node scripts/dev-business.mjs",
    "test:business": "node scripts/verify-business-flow.mjs"
  }
}
