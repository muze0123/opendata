FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY backend/pom.xml backend/pom.xml
COPY backend/application/pom.xml backend/application/pom.xml
COPY backend/application/src backend/application/src
RUN mvn -B -f backend/pom.xml -Dmaven.test.skip=true package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /workspace/backend/application/target/opendata-application-0.1.0-SNAPSHOT.jar application.jar
USER 10001:10001
EXPOSE 4320
ENTRYPOINT ["java", "-jar", "application.jar"]
